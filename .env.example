# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ===================================================================
# --- CENPLEX PRAXISMAIL (RECOMMENDED FOR CENPLEX USERS) ---
# ===================================================================
# Cenplex Mail Server: mail.praxismail.ch
SMTP_HOST="mail.praxismail.ch"
# Port: 587 (STARTTLS) or 465 (SSL)
SMTP_PORT="587"
SMTP_SECURE="false"
# Doctor's Cenplex Email Address:
SMTP_USER="info@lebenswerk.praxismail.ch"
# Cenplex Email Password:
SMTP_PASS="Lebenswerk2025"

# Doctor Recipient Email (where patient booking alerts are delivered instantly):
DOCTOR_NOTIFICATION_EMAIL="info@lebenswerk.praxismail.ch"

# ===================================================================
# --- ALTERNATIVE EMAIL OPTIONS ---
# ===================================================================
# OPTION B: Hostpoint Swiss Email
# SMTP_HOST="asmtp.mail.hostpoint.ch"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="info@lebenswerk.praxismail.ch"
# SMTP_PASS="your-hostpoint-password"

# OPTION C: Gmail SMTP (requires 16-character Google App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# OPTION D: Resend API Key
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LEBENSWERK Physiotherapie <onboarding@resend.dev>"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
